<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>겹받침 · Phụ âm cuối đôi trong tiếng Hàn</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;900&family=Be+Vietnam+Pro:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#141a2e;
    --bg-alt:#1c2440;
    --paper:#f4ead6;
    --paper-dim:#e9dcc0;
    --ink:#241f18;
    --red:#c1432f;
    --gold:#d3a55f;
    --mint:#6fb99f;
    --line: rgba(244,234,214,0.16);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(circle at 15% 8%, rgba(211,165,95,0.10), transparent 40%),
      radial-gradient(circle at 90% 85%, rgba(193,67,47,0.10), transparent 45%),
      var(--bg);
    color:var(--paper);
    font-family:'Be Vietnam Pro', sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  .hangul{font-family:'Noto Serif KR', serif;}
  .mono{font-family:'JetBrains Mono', monospace;}

  .wrap{max-width:960px;margin:0 auto;padding:0 24px;}

  /* ---------- HERO ---------- */
  header.hero{
    padding:72px 0 56px;
    border-bottom:1px solid var(--line);
  }
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--gold);font-weight:600;margin-bottom:22px;
  }
  .eyebrow::before{content:"";width:18px;height:1px;background:var(--gold);}
  h1.title{
    font-family:'Noto Serif KR', serif;
    font-weight:900;
    font-size:clamp(26px,4.6vw,44px);
    margin:0 0 6px 0;
    letter-spacing:-0.01em;
    color:var(--paper);
  }
  .subtitle{
    font-size:clamp(17px,2.4vw,21px);
    color:var(--paper-dim);
    font-weight:500;
    max-width:680px;
    margin-bottom:10px;
  }
  .subtitle b{color:var(--red);font-weight:700;}

  /* ---------- SECTIONS ---------- */
  section{padding:56px 0;border-bottom:1px solid var(--line);}
  .sec-label{
    font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--red);font-weight:700;margin-bottom:10px;
  }
  h2{
    font-family:'Noto Serif KR',serif;
    font-weight:600;
    font-size:clamp(26px,3.4vw,34px);
    margin:0 0 18px 0;
    color:var(--paper);
  }
  p.lead{color:var(--paper-dim);max-width:660px;font-size:16px;}

  /* ---------- syllable / contrast diagram ---------- */
  .syllable-diagram{
    display:flex;align-items:center;gap:20px;margin-top:28px;flex-wrap:wrap;
  }
  .syl-block{display:flex;flex-direction:column;gap:6px;}
  .syl-part{
    background:var(--paper);color:var(--ink);border-radius:6px;
    padding:10px 18px;font-family:'Noto Serif KR',serif;font-size:22px;font-weight:600;
    display:flex;align-items:center;gap:12px;min-width:150px;
  }
  .syl-part span{
    font-family:'Be Vietnam Pro',sans-serif;font-size:10.5px;font-weight:700;
    color:var(--red);text-transform:uppercase;letter-spacing:.05em;
  }
  .syl-part.syl-jong{border:2px solid var(--red);}
  .syl-part.syl-drop{opacity:.4;text-decoration:line-through;}
  .syl-eq{font-size:28px;color:var(--gold);font-weight:700;}
  .syl-result{
    font-family:'Noto Serif KR',serif;font-size:56px;font-weight:900;color:var(--paper);
    background:var(--bg-alt);border:1px solid var(--line);border-radius:10px;padding:8px 26px;
  }
  @media(max-width:520px){.syl-result{font-size:40px;padding:6px 16px;}}

  /* ---------- rule cards ---------- */
  .rules{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:28px;}
  @media(max-width:900px){.rules{grid-template-columns:1fr 1fr;}}
  @media(max-width:560px){.rules{grid-template-columns:1fr;}}
  .rule-card{
    background:var(--paper);color:var(--ink);
    border-radius:6px;padding:22px 20px;border-top:4px solid var(--mint);
  }
  .rule-card.g-left{border-top-color:var(--mint);}
  .rule-card.g-right{border-top-color:var(--gold);}
  .rule-card.g-h{border-top-color:var(--red);}
  .rule-tag{font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--red);font-weight:700;margin-bottom:12px;}
  .rule-formula{
    font-family:'Noto Serif KR',serif;font-size:20px;font-weight:600;
    display:flex;align-items:center;gap:6px;margin-bottom:10px;flex-wrap:wrap;
    letter-spacing:.04em;
  }
  .rule-note{font-size:14px;color:#4a4237;}
  .rule-example{
    margin-top:14px;font-size:13.5px;color:#5a5142;
    border-top:1px dashed rgba(36,31,24,0.2);padding-top:12px;
  }
  .rule-example b{color:var(--ink);}

  .note-box{
    border-left:2px solid var(--gold);
    padding:12px 18px;margin-top:18px;
    font-size:13.5px;color:var(--paper-dim);background:rgba(211,165,95,0.06);
  }
  .note-box b{color:var(--gold);}

  /* ---------- examples grid ---------- */
  .examples-grid{
    display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:26px;
  }
  @media(max-width:640px){.examples-grid{grid-template-columns:1fr;}}
  .ex-pair{
    position:relative;
    background:var(--bg-alt);border:1px solid var(--line);border-radius:6px;
    padding:18px 14px 14px;border-top:3px solid var(--line);
  }
  .ex-pair.g-left{border-top-color:var(--mint);}
  .ex-pair.g-right{border-top-color:var(--gold);}
  .ex-pair.g-h{border-top-color:var(--red);}
  .ex-badge{
    position:absolute;top:-10px;left:-10px;
    width:22px;height:22px;border-radius:50%;
    background:var(--bg);border:1.5px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;color:var(--paper-dim);
  }
  .ex-pair-written{
    text-align:center;font-family:'Noto Serif KR',serif;font-size:15px;font-weight:600;
    color:var(--paper-dim);margin-bottom:4px;
  }
  .ex-pair-written .tag{
    font-family:'Be Vietnam Pro',sans-serif;font-size:9.5px;font-weight:600;
    text-transform:uppercase;letter-spacing:.05em;color:var(--gold);
  }
  .ex-pair-row{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:8px;}
  .ex-pair-btn{
    flex:1;text-align:center;cursor:pointer;border-radius:6px;padding:12px 8px;
    border:1.5px solid var(--line);transition:border-color .2s, transform .2s;
  }
  .ex-pair-btn:hover{border-color:var(--gold);transform:translateY(-2px);}
  .ex-pair-btn .w{font-family:'Noto Serif KR',serif;font-size:24px;font-weight:600;color:var(--paper);}
  .ex-pair-btn .tag{font-size:10px;margin-top:5px;text-transform:uppercase;letter-spacing:.05em;color:var(--paper-dim);}
  .ex-pair-btn.pron{border-color:rgba(193,67,47,0.35);}
  .ex-pair-btn.pron .w{color:var(--red);}
  .ex-pair-btn.pron .tag{color:var(--red);font-weight:700;}
  .ex-pair-arrow{color:var(--gold);font-size:16px;flex-shrink:0;}
  .ex-pair-meaning{font-size:11.5px;color:var(--paper-dim);text-align:center;margin-top:10px;min-height:16px;line-height:1.4;}

  /* ---------- PRACTICE ---------- */
  .practice-box{
    background:var(--paper);color:var(--ink);
    border-radius:8px;
    padding:32px 28px;
    margin-top:26px;
  }
  .dots{display:flex;gap:6px;margin-bottom:22px;flex-wrap:wrap;}
  .dot{width:8px;height:8px;border-radius:50%;background:rgba(36,31,24,0.18);}
  .dot.active{background:var(--red);}
  .dot.done{background:var(--mint);}

  .p-word{font-family:'Noto Serif KR',serif;font-size:52px;font-weight:900;text-align:center;margin:6px 0 4px;}
  .p-mean{text-align:center;color:#6a6152;font-size:14px;margin-bottom:26px;}

  .p-controls{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
  .btn{
    font-family:'Be Vietnam Pro',sans-serif;font-weight:600;font-size:14.5px;
    border:none;border-radius:5px;padding:11px 18px;cursor:pointer;
    transition:transform .15s, opacity .15s;
  }
  .btn:active{transform:scale(0.96);}
  .btn-primary{background:var(--red);color:#fff;}
  .btn-secondary{background:transparent;color:var(--ink);border:1.5px solid rgba(36,31,24,0.3);}
  .btn-mint{background:var(--mint);color:#08221a;}
  .btn:disabled{opacity:.4;cursor:not-allowed;}

  .countdown-zone{
    min-height:64px;display:flex;align-items:center;justify-content:center;
    margin-bottom:10px;
  }
  .countdown-num{font-family:'Noto Serif KR',serif;font-size:44px;font-weight:900;color:var(--gold);}
  .go-prompt{
    font-size:19px;font-weight:700;color:var(--red);
    animation:pulseGlow 0.9s ease-in-out infinite;
  }
  @keyframes pulseGlow{
    0%,100%{opacity:1;} 50%{opacity:.45;}
  }

  .reveal-panel{
    display:none;
    background:var(--bg);color:var(--paper);
    border-radius:6px;padding:18px 20px;margin-top:6px;
  }
  .reveal-panel.show{display:block;animation:pop .3s ease;}
  @keyframes pop{0%{transform:scale(0.7);opacity:0;}100%{transform:scale(1);opacity:1;}}
  .reveal-row{display:flex;gap:14px;align-items:baseline;flex-wrap:wrap;margin-bottom:10px;}
  .reveal-row .k{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--gold);width:150px;}
  .reveal-row .v{font-family:'Noto Serif KR',serif;font-size:22px;}
  .reveal-row .v.mono2{font-family:'JetBrains Mono',monospace;font-size:15px;color:var(--paper-dim);}
  .tip{font-size:14px;color:var(--paper-dim);margin-top:10px;padding-top:10px;border-top:1px solid var(--line);}

  .quiz-zone{margin-top:20px;display:none;}
  .quiz-zone.show{display:block;animation:pop .3s ease;}
  .quiz-q{font-size:15px;font-weight:600;margin-bottom:12px;}
  .quiz-opts{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  @media(max-width:520px){.quiz-opts{grid-template-columns:1fr;}}
  .quiz-opt{
    font-family:'Noto Serif KR',serif;font-weight:600;font-size:30px;
    background:var(--bg);color:var(--paper);
    border:1.5px solid rgba(244,234,214,0.2);
    border-radius:5px;padding:14px 14px;cursor:pointer;text-align:center;
  }
  .quiz-opt:hover{border-color:var(--gold);}
  .quiz-opt.correct{background:rgba(111,185,159,0.18);border-color:var(--mint);}
  .quiz-opt.wrong{background:rgba(193,67,47,0.18);border-color:var(--red);}
  .quiz-fb{margin-top:10px;font-size:13.5px;color:var(--paper-dim);min-height:18px;}

  .p-footer{
    display:flex;justify-content:space-between;align-items:center;margin-top:24px;
  }
  .score{font-family:'JetBrains Mono',monospace;font-size:13px;color:#6a6152;}

  .final-screen{display:none;text-align:center;padding:20px 0;}
  .final-screen.show{display:block;}
  .final-num{font-family:'Noto Serif KR',serif;font-size:64px;font-weight:900;color:var(--red);}

  footer{padding:40px 0 70px;}
  footer p{color:var(--paper-dim);font-size:13.5px;max-width:640px;}

  @media(prefers-reduced-motion: reduce){
    *{animation-duration:0.001s !important; animation-iteration-count:1 !important;}
  }

  .site-logo{
    position:fixed;
    top:14px;left:18px;
    height:30px;width:auto;
    z-index:100;
    opacity:0.96;
  }
  @media(max-width:520px){.site-logo{height:22px;top:10px;left:12px;}}
</style>
</head>
<body>
<img class="site-logo" src="data:image/png;base64," alt="VLU Korean Language and Culture">

<header class="hero">
  <div class="wrap">
    <div class="eyebrow">Ngữ âm tiếng Hàn · Phụ âm cuối đôi (3)</div>
    <h1 class="title hangul">받침 (3) Phụ âm cuối đôi</h1>
    <p class="subtitle">Phụ âm cuối đôi (겹받침) là phụ âm cuối được viết bằng <b>hai phụ âm khác nhau</b> kết hợp với nhau (ví dụ: ㄳ, ㄵ, ㄺ, ㄻ...). Khi đứng ở cuối từ hoặc trước một phụ âm khác, thường <b>chỉ một trong hai phụ âm được phát âm</b>. Phụ âm còn lại không được phát âm ở vị trí phụ âm cuối.</p>
  </div>
</header>

<section>
  <div class="wrap">
    <div class="sec-label">01 · Khái niệm</div>
    <h2>겹받침[gyeopbatchim: Phụ âm cuối đôi] là gì?</h2>
    <p class="lead">Một số âm tiết có <b style="color:var(--paper)">2 phụ âm khác nhau</b> viết chồng lên nhau ở vị trí 받침. Khi âm tiết đó đứng <b style="color:var(--paper)">cuối từ</b> hoặc <b style="color:var(--paper)">trước một phụ âm khác</b>, chỉ <b style="color:var(--paper)">1 trong 2 chữ</b> được phát âm.</p>

    <div class="syllable-diagram">
      <div class="syl-block">
        <div class="syl-part">ㄷ<span>PHỤ ÂM ĐẦU</span></div>
        <div class="syl-part">ㅏ<span>NGUYÊN ÂM</span></div>
        <div class="syl-part syl-jong">ㄹㄱ<span>PHỤ ÂM CUỐI ĐÔI (ㄺ)</span></div>
      </div>
      <div class="syl-eq">→</div>
      <div class="syl-result hangul">닥</div>
    </div>
    <p class="lead" style="margin-top:14px;font-size:14px;">Ví dụ trên: <b class="hangul" style="color:var(--paper)">닭</b> (gà) viết với 겹받침 <b class="hangul">ㄺ</b> (= ㄹ + ㄱ), nhưng chỉ đọc <b style="color:var(--red)">[닥]</b> — chữ <b class="hangul" style="text-decoration:line-through;opacity:.6;">ㄹ</b> bị lược bỏ, chỉ giữ lại <b class="hangul">ㄱ</b>.</p>

    <div class="note-box">
      <b>Phân biệt với 쌍받침:</b> 겹받침 (2 chữ <u>khác nhau</u>, VD ㄳ, ㄺ, ㅄ) khác với <b>쌍받침</b> (2 chữ <u>giống nhau</u>, VD ㄲ, ㅆ — đã học ở bài <b>받침 (2)</b>, thuộc nhóm 7 âm đại diện). 쌍받침 chỉ là 1 âm viết nhân đôi; 겹받침 là 2 âm khác nhau viết chồng, và quy tắc chọn âm phức tạp hơn nhiều.
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-label">02 · Ba nhóm chọn âm</div>
    <h2>Quy tắc chọn 1 trong 2 phụ âm</h2>
    <p class="lead">11 겹받침 chia thành <b style="color:var(--paper)">3 nhóm</b> theo việc <b style="color:var(--paper)">chữ nào được giữ lại</b>: giữ chữ bên trái, giữ chữ bên phải, hoặc kết hợp đặc biệt với ㅎ.</p>

    <div class="rules">
      <div class="rule-card g-left">
        <div class="rule-tag">Nhóm 1 — Giữ chữ TRÁI</div>
        <div class="rule-formula hangul">ㄳㄵㄼㄽㄾㅄ</div>
        <div class="rule-note">6 겹받침 phổ biến nhất — chữ đầu tiên (bên trái) được giữ lại và đọc lên, chữ thứ hai bị lược bỏ.</div>
        <div class="rule-example">Ví dụ: <b class="hangul">값</b>(ㅄ)→[갑], <b class="hangul">여덟</b>(ㄼ)→[여덜], <b class="hangul">앉다</b>(ㄵ)→[안따].</div>
      </div>
      <div class="rule-card g-right">
        <div class="rule-tag">Nhóm 2 — Giữ chữ PHẢI</div>
        <div class="rule-formula hangul">ㄺㄻㄿ</div>
        <div class="rule-note">3 겹받침 "ngược" — ngược với nhóm 1, chữ thứ hai (bên phải) mới được giữ lại, chữ đầu tiên bị lược bỏ.</div>
        <div class="rule-example">Ví dụ: <b class="hangul">닭</b>(ㄺ)→[닥], <b class="hangul">읽다</b>(ㄺ)→[익따]. (ㄻ, ㄿ áp dụng quy tắc tương tự: 삶→[삼], 읊다→[읍따].)</div>
      </div>
      <div class="rule-card g-h">
        <div class="rule-tag">Nhóm 3 — Kết hợp với ㅎ</div>
        <div class="rule-formula hangul">ㄶㅀ</div>
        <div class="rule-note">ㅎ không "cạnh tranh" như 2 nhóm trên — nó biến mất nhưng làm phụ âm phía sau (nếu có) bật hơi lên (như quy tắc <b>bật hơi hóa</b> đã học), còn ㄴ/ㄹ vẫn giữ lại làm 받침.</div>
        <div class="rule-example">Ví dụ: <b class="hangul">많다</b>(ㄶ)→[만타], <b class="hangul">끊다</b>(ㄶ)→[끈타], <b class="hangul">끓다</b>(ㅀ)→[끌타], <b class="hangul">싫다</b>(ㅀ)→[실타].</div>
      </div>
    </div>

    <div class="note-box">
      <b>2 ngoại lệ cần nhớ:</b> (1) <b class="hangul">밟다</b> (giẫm/đạp) là ngoại lệ của nhóm ㄼ — đáng lẽ giữ ㄹ nhưng thực tế đọc <b>[밥따]</b> (giữ ㅂ). (2) 겹받침 <b class="hangul">ㄺ</b> khi đứng <b>trước một âm ㄱ khác</b> thì đổi ngược lại, giữ ㄹ thay vì ㄱ — VD <b class="hangul">맑고</b> → <b>[말꼬]</b> (không phải [막꼬]).
    </div>

    <div class="note-box">
      <b>Khi theo sau là nguyên âm (liên âm/연음):</b> quy tắc trên chỉ áp dụng khi 겹받침 đứng <b>cuối từ hoặc trước phụ âm</b>. Nếu ngay sau là một nguyên âm (VD thêm đuôi câu -아/어), <b>cả 2 phụ âm đều được đọc</b> theo quy tắc liên âm (연음) đã học — VD <b class="hangul">앉아</b> → [안자] (ㄴ ở lại, ㅈ chuyển sang đầu âm tiết sau). Đây là chủ đề riêng, sẽ ôn kỹ hơn khi học lại liên âm.
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-label">03 · Nghe & so sánh</div>
    <h2>Bấm để nghe: viết 2 chữ, đọc 1 chữ</h2>
    <p class="lead">Mỗi thẻ có 2 nút: chữ <b style="color:var(--paper)">viết ra</b> (겹받침 đầy đủ) và âm <b style="color:var(--red)">đọc thật</b> (chỉ còn 1 phụ âm cuối).</p>

    <div class="examples-grid" id="examplesGrid"></div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-label">04 · Luyện tập</div>
    <h2>Luyện chọn đúng phụ âm được giữ lại</h2>
    <p class="lead">Nghe mẫu → đến lượt bạn nói to → xem đáp án → chọn đúng phụ âm được giữ lại trong 겹받침. Lặp lại cho cả 12 từ.</p>

    <div class="practice-box" id="practiceBox">
      <div class="dots" id="dots"></div>

      <div id="playScreen">
        <div class="p-word hangul" id="pWord">닭</div>
        <div class="p-mean" id="pMean">gà</div>

        <div class="countdown-zone" id="countdownZone"></div>

        <div class="p-controls">
          <button class="btn btn-primary" id="btnListen">🔊 Nghe mẫu</button>
          <button class="btn btn-secondary" id="btnYourTurn">🎯 Đến lượt bạn</button>
          <button class="btn btn-secondary" id="btnReveal" disabled>👁 Xem đáp án</button>
        </div>

        <div class="reveal-panel" id="revealPanel">
          <div class="reveal-row"><div class="k">Chữ viết</div><div class="v hangul" id="rvWritten"></div></div>
          <div class="reveal-row"><div class="k">Đọc thật</div><div class="v mono2" id="rvSound" style="color:var(--red)"></div></div>
          <div class="tip" id="rvTip"></div>
        </div>

        <div class="quiz-zone" id="quizZone">
          <div class="quiz-q" id="quizQ">겹받침 này giữ lại phụ âm nào?</div>
          <div class="quiz-opts" id="quizOpts"></div>
          <div class="quiz-fb" id="quizFb"></div>
        </div>

        <div class="p-footer">
          <div class="score" id="scoreText">Điểm: 0 / 12</div>
          <button class="btn btn-mint" id="btnNext" style="display:none;">Từ tiếp theo →</button>
        </div>
      </div>

      <div class="final-screen" id="finalScreen">
        <div class="sec-label" style="color:var(--red)">Hoàn thành</div>
        <div class="final-num" id="finalScore">0 / 12</div>
        <p style="color:#6a6152;max-width:440px;margin:10px auto 22px;">Bạn đã luyện xong 12 từ, đủ 6 겹받침 phổ biến nhất. Cộng với 받침 (1) và 받침 (2), bạn đã nắm toàn bộ hệ thống 받침 cơ bản của tiếng Hàn!</p>
        <button class="btn btn-primary" id="btnRestart">↺ Luyện lại từ đầu</button>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <p><b style="color:var(--paper)">Bước tiếp theo:</b> ôn lại liên âm (연음) để hiểu vì sao 겹받침 đọc khác hẳn khi theo sau là nguyên âm (VD 앉아 → [안자], 닭이 → [달기]), và luyện áp dụng đồng thời cả 3 bài 받침 (1)(2)(3) vào từ vựng thực tế.</p>
  </div>
</footer>

<script>
const DATA = [
  {word:"닭", pron:"닥", writtenJong:"ㄺ", front:"ㄹ", back:"ㄱ", keep:"ㄱ", group:"right", meaning:"gà", explain:"겹받침 ㄺ = ㄹ+ㄱ. Nhóm giữ chữ PHẢI (ngược lại) → giữ ㄱ, lược bỏ ㄹ. (Ngoại lệ: trước âm ㄱ khác thì đổi lại giữ ㄹ — VD 맑고→[말꼬].)"},
  {word:"읽다", pron:"익따", writtenJong:"ㄺ", front:"ㄹ", back:"ㄱ", keep:"ㄱ", group:"right", meaning:"đọc", explain:"겹받침 ㄺ = ㄹ+ㄱ. Nhóm giữ chữ PHẢI → giữ ㄱ, lược bỏ ㄹ. Đuôi '다' căng hóa thành '따' sau 받침 ㄱ."},
  {word:"여덟", pron:"여덜", writtenJong:"ㄼ", front:"ㄹ", back:"ㅂ", keep:"ㄹ", group:"left", meaning:"số 8, tám", explain:"겹받침 ㄼ = ㄹ+ㅂ. Nhóm giữ chữ TRÁI → giữ ㄹ, lược bỏ ㅂ. (Ngoại lệ: 밟다 lại giữ ㅂ — xem ghi chú ở trên.)"},
  {word:"짧다", pron:"짤따", writtenJong:"ㄼ", front:"ㄹ", back:"ㅂ", keep:"ㄹ", group:"left", meaning:"ngắn", explain:"겹받침 ㄼ = ㄹ+ㅂ. Nhóm giữ chữ TRÁI → giữ ㄹ, lược bỏ ㅂ. Đuôi '다' căng hóa thành '따' sau 받침 ㄹ."},
  {word:"끓다", pron:"끌타", writtenJong:"ㅀ", front:"ㄹ", back:"ㅎ", keep:"ㄹ", group:"h", meaning:"sôi", explain:"겹받침 ㅀ = ㄹ+ㅎ. ㄹ giữ lại làm 받침; ㅎ biến mất nhưng làm 'ㄷ' của đuôi '다' bật hơi thành 'ㅌ' → [끌타]."},
  {word:"싫다", pron:"실타", writtenJong:"ㅀ", front:"ㄹ", back:"ㅎ", keep:"ㄹ", group:"h", meaning:"không thích, ghét", explain:"겹받침 ㅀ = ㄹ+ㅎ. ㄹ giữ lại làm 받침; ㅎ biến mất nhưng làm 'ㄷ' của đuôi '다' bật hơi thành 'ㅌ' → [실타]."},
  {word:"값", pron:"갑", writtenJong:"ㅄ", front:"ㅂ", back:"ㅅ", keep:"ㅂ", group:"left", meaning:"giá, giá trị", explain:"겹받침 ㅄ = ㅂ+ㅅ. Nhóm giữ chữ TRÁI → giữ ㅂ, lược bỏ ㅅ."},
  {word:"없다", pron:"업따", writtenJong:"ㅄ", front:"ㅂ", back:"ㅅ", keep:"ㅂ", group:"left", meaning:"không có, không tồn tại", explain:"겹받침 ㅄ = ㅂ+ㅅ. Nhóm giữ chữ TRÁI → giữ ㅂ, lược bỏ ㅅ. Đuôi '다' căng hóa thành '따' sau 받침 ㅂ."},
  {word:"앉다", pron:"안따", writtenJong:"ㄵ", front:"ㄴ", back:"ㅈ", keep:"ㄴ", group:"left", meaning:"ngồi", explain:"겹받침 ㄵ = ㄴ+ㅈ. Nhóm giữ chữ TRÁI → giữ ㄴ, lược bỏ ㅈ. Đuôi '다' căng hóa thành '따' sau 받침 ㄴ của động từ."},
  {word:"얹다", pron:"언따", writtenJong:"ㄵ", front:"ㄴ", back:"ㅈ", keep:"ㄴ", group:"left", meaning:"đặt lên trên", explain:"겹받침 ㄵ = ㄴ+ㅈ. Nhóm giữ chữ TRÁI → giữ ㄴ, lược bỏ ㅈ. Đuôi '다' căng hóa thành '따'."},
  {word:"많다", pron:"만타", writtenJong:"ㄶ", front:"ㄴ", back:"ㅎ", keep:"ㄴ", group:"h", meaning:"nhiều", explain:"겹받침 ㄶ = ㄴ+ㅎ. ㄴ giữ lại làm 받침; ㅎ biến mất nhưng làm 'ㄷ' của đuôi '다' bật hơi thành 'ㅌ' → [만타]."},
  {word:"끊다", pron:"끈타", writtenJong:"ㄶ", front:"ㄴ", back:"ㅎ", keep:"ㄴ", group:"h", meaning:"cắt đứt, ngắt", explain:"겹받침 ㄶ = ㄴ+ㅎ. ㄴ giữ lại làm 받침; ㅎ biến mất nhưng làm 'ㄷ' của đuôi '다' bật hơi thành 'ㅌ' → [끈타]."},
];
const GROUP_CLASS = {"left":"g-left","right":"g-right","h":"g-h"};

/* ---------- examples grid (chữ viết vs âm đọc thật) ---------- */
const grid = document.getElementById('examplesGrid');
DATA.forEach((d,i)=>{
  const card = document.createElement('div');
  card.className = 'ex-pair ' + GROUP_CLASS[d.group];
  card.innerHTML = `
    <div class="ex-badge">${i+1}</div>
    <div class="ex-pair-written">${d.word} <span class="tag">겹받침 ${d.writtenJong}</span></div>
    <div class="ex-pair-row">
      <div class="ex-pair-btn written">
        <div class="w hangul">${d.word}</div>
        <div class="tag">chữ viết</div>
      </div>
      <div class="ex-pair-arrow">→</div>
      <div class="ex-pair-btn pron">
        <div class="w hangul">[${d.pron}]</div>
        <div class="tag">đọc thật (giữ ${d.keep})</div>
      </div>
    </div>
    <div class="ex-pair-meaning"></div>
  `;
  const meanEl = card.querySelector('.ex-pair-meaning');
  card.querySelector('.written').addEventListener('click', ()=>{
    meanEl.textContent = `${d.word}: ${d.meaning}`;
  });
  card.querySelector('.pron').addEventListener('click', ()=>{
    meanEl.textContent = d.explain;
    playAudio(i);
  });
  grid.appendChild(card);
});

/* ---------- audio helper (녹음 파일 재생, base64로 내장되어 별도 파일 필요 없음) ---------- */
/* 아직 녹음 파일을 받지 못해 자리만 비워둠 — 12개 단어(실제 발음 그대로) 필요 */
const AUDIO_FILES = [
  'data:audio/mpeg;base64,', // 닭 (실제 발음 닥)
  'data:audio/mpeg;base64,', // 읽다 (실제 발음 익따)
  'data:audio/mpeg;base64,', // 여덟 (실제 발음 여덜)
  'data:audio/mpeg;base64,', // 짧다 (실제 발음 짤따)
  'data:audio/mpeg;base64,', // 끓다 (실제 발음 끌타)
  'data:audio/mpeg;base64,', // 싫다 (실제 발음 실타)
  'data:audio/mpeg;base64,', // 값 (실제 발음 갑)
  'data:audio/mpeg;base64,', // 없다 (실제 발음 업따)
  'data:audio/mpeg;base64,', // 앉다 (실제 발음 안따)
  'data:audio/mpeg;base64,', // 얹다 (실제 발음 언따)
  'data:audio/mpeg;base64,', // 많다 (실제 발음 만타)
  'data:audio/mpeg;base64,', // 끊다 (실제 발음 끈타)
];
const audioCache = {};
function getAudio(i){
  if(!AUDIO_FILES[i]) return null;
  if(!audioCache[i]){
    audioCache[i] = new Audio(AUDIO_FILES[i]);
  }
  return audioCache[i];
}
function playAudio(i){
  const audio = getAudio(i);
  if(!audio) return;
  audio.currentTime = 0;
  audio.play().catch(err=>console.error('오디오 재생 실패:', err));
}

/* ---------- practice state ---------- */
let idx = 0;
let score = 0;
let answered = new Array(DATA.length).fill(false);

const dotsEl = document.getElementById('dots');
DATA.forEach((_,i)=>{
  const d = document.createElement('div');
  d.className = 'dot' + (i===0 ? ' active':'');
  dotsEl.appendChild(d);
});

const pWord = document.getElementById('pWord');
const pMean = document.getElementById('pMean');
const countdownZone = document.getElementById('countdownZone');
const btnListen = document.getElementById('btnListen');
const btnYourTurn = document.getElementById('btnYourTurn');
const btnReveal = document.getElementById('btnReveal');
const revealPanel = document.getElementById('revealPanel');
const quizZone = document.getElementById('quizZone');
const quizQ = document.getElementById('quizQ');
const quizOpts = document.getElementById('quizOpts');
const quizFb = document.getElementById('quizFb');
const scoreText = document.getElementById('scoreText');
const btnNext = document.getElementById('btnNext');
const playScreen = document.getElementById('playScreen');
const finalScreen = document.getElementById('finalScreen');

function renderDots(){
  [...dotsEl.children].forEach((d,i)=>{
    d.className = 'dot' + (i===idx?' active':(answered[i]?' done':''));
  });
}

function loadWord(){
  const d = DATA[idx];
  pWord.textContent = d.word;
  pMean.textContent = d.meaning;
  countdownZone.innerHTML = '';
  btnReveal.disabled = true;
  revealPanel.classList.remove('show');
  quizZone.classList.remove('show');
  quizFb.textContent = '';
  btnNext.style.display = 'none';
  renderDots();
  scoreText.textContent = `Điểm: ${score} / ${DATA.length}`;
}
loadWord();

btnListen.addEventListener('click', ()=>{
  playAudio(idx);
});

btnYourTurn.addEventListener('click', ()=>{
  btnYourTurn.disabled = true;
  let n = 3;
  countdownZone.innerHTML = `<div class="countdown-num">${n}</div>`;
  const iv = setInterval(()=>{
    n--;
    if(n > 0){
      countdownZone.innerHTML = `<div class="countdown-num">${n}</div>`;
    } else {
      clearInterval(iv);
      countdownZone.innerHTML = `<div class="go-prompt">Nói to lên nào! 🗣️</div>`;
      setTimeout(()=>{
        countdownZone.innerHTML = '';
        btnYourTurn.disabled = false;
        btnReveal.disabled = false;
      }, 2200);
    }
  }, 700);
});

btnReveal.addEventListener('click', ()=>{
  const d = DATA[idx];
  document.getElementById('rvWritten').textContent = d.word;
  document.getElementById('rvSound').textContent = `[${d.pron}]`;
  document.getElementById('rvTip').textContent = d.explain;
  revealPanel.classList.add('show');

  quizQ.textContent = `겹받침 "${d.writtenJong}" (${d.front}+${d.back}) trong từ "${d.word}" — giữ lại phụ âm nào?`;
  quizOpts.innerHTML = '';
  const opts = Math.random() > 0.5 ? [d.front, d.back] : [d.back, d.front];
  opts.forEach(opt=>{
    const b = document.createElement('div');
    b.className = 'quiz-opt hangul';
    b.textContent = opt;
    b.addEventListener('click', ()=>{
      if(answered[idx]) return;
      answered[idx] = true;
      const correct = opt === d.keep;
      [...quizOpts.children].forEach(c=>{
        if(c.textContent === d.keep) c.classList.add('correct');
        else if(c === b) c.classList.add('wrong');
      });
      if(correct){
        score++;
        quizFb.textContent = 'Chính xác! ✅';
      } else {
        quizFb.textContent = `Chưa đúng — phụ âm được giữ là ${d.keep} (đọc [${d.pron}]). Nghe lại và thử lần sau nhé.`;
      }
      scoreText.textContent = `Điểm: ${score} / ${DATA.length}`;
      renderDots();
      btnNext.style.display = 'inline-block';
    });
    quizOpts.appendChild(b);
  });
  quizZone.classList.add('show');
});

btnNext.addEventListener('click', ()=>{
  if(idx < DATA.length - 1){
    idx++;
    loadWord();
  } else {
    playScreen.style.display = 'none';
    document.getElementById('finalScore').textContent = `${score} / ${DATA.length}`;
    finalScreen.classList.add('show');
  }
});

document.getElementById('btnRestart').addEventListener('click', ()=>{
  idx = 0; score = 0; answered = new Array(DATA.length).fill(false);
  finalScreen.classList.remove('show');
  playScreen.style.display = 'block';
  loadWord();
});
</script>

</body>
</html>
